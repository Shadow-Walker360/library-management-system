# PostgreSQL connection string (hosted providers usually require sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# Secret used to sign JWTs - use a long random string
JWT_SECRET="replace-with-a-long-random-string"

# Password given to the seeded librarian and patron accounts
SEED_USER_PASSWORD="replace-with-a-dev-password"
